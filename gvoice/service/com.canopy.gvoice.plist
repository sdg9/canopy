<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.canopy.gvoice</string>
    <key>ProgramArguments</key>
    <array>
        <string>__SERVICE_DIR__/CanopyGvoice.app/Contents/MacOS/canopy-gvoice</string>
        <string>__NODE_PATH__</string>
        <string>__SERVICE_DIR__/server.js</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>5</integer>
    <key>StandardOutPath</key>
    <string>/tmp/canopy-gvoice.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/canopy-gvoice.err</string>
</dict>
</plist>
